---
// Decorative Boğaz current lines (UPDATE-02 B2). aria-hidden, no interaction.
// Colour = currentColor at a token opacity (--contour-*). Optional 40 s drift,
// only when motion is allowed (paused by the browser in background tabs).
import { contourPath } from "../../lib/contours";
interface Props { variant?: "hero" | "footer"; class?: string }
const { variant = "hero", class: cls = "" } = Astro.props;
const d = variant === "hero"
  ? contourPath({ lines: 16, points: 11, seed: 1453 })
  : contourPath({ lines: 7, points: 9, seed: 1863, height: 360, amp: 0.7 });
const vb = variant === "hero" ? "0 0 1440 640" : "0 0 1440 360";
---
<svg class:list={["contours", `contours--${variant}`, cls]} viewBox={vb} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <path d={d} fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
</svg>
<style>
  .contours { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; color: var(--contour); }
  .contours--footer { opacity: 0.7; }
  @media (prefers-reduced-motion: no-preference) {
    .contours--hero path { animation: drift 40s linear infinite alternate; }
    @keyframes drift { to { transform: translateX(-60px); } }
  }
</style>
